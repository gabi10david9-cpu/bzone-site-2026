# Portul pe care pornește serverul (majoritatea hosturilor îl setează singure)
PORT=3000

# IMPORTANT: schimbă asta cu un șir lung, random, secret. Nu-l posta nicăieri public.
# Poți genera unul rapid cu: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=schimba-acest-secret-cu-ceva-lung-si-random

# Câte zile rămâne valabilă sesiunea (tokenul) unui utilizator autentificat
JWT_EXPIRES_IN=30d

# Unde se salvează fișierul bazei de date SQLite (se creează automat)
DB_PATH=./data/bzone.db

# Originea permisă pentru cereri cross-origin. Dacă frontend-ul e servit de
# același server (cazul implicit din acest proiect), poți lăsa *.
CORS_ORIGIN=*
